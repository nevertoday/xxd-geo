---
import Site from "../layouts/Site.astro";
import { WIKI, WIKI_GROUPS } from "../data/wiki.js";
import { wikiHref, link, langOf } from "../data/nav.js";
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const items = WIKI.map((w) => ({ ...w, ...w[lang], group: w.group }));
const gName = (g) => g;
const headings = WIKI_GROUPS.map((g, i) => ({ slug: `g${i}`, text: gName(g), depth: 2 }));
const T = en
  ? { h: "Wiki: what is it", p1: "Every term on this site, explained in plain words. Each one starts with a single sentence; read on only if you want more.", p2: ["Hover over any word with a dotted underline for a one-line explanation. To see which tactics have evidence behind them, go to ", "the evidence table", "."] }
  : { h: "Wiki：这是什么", p1: "网站上出现的每个词，用大白话讲清楚。每篇第一句就是答案，想多了解再往下看。", p2: ["正文里带虚线的词，鼠标停在上面就能看到一句话解释。想知道哪些做法有证据，去看", "证据表", "。"] };
---
<Site title={T.h} headings={headings}>
  <article class="xxd-prose">
    <h1>{T.h}</h1>
    <p>{T.p1}</p>
    <p>{T.p2[0]}<a href={link("/evidence/", lang)}>{T.p2[1]}</a>{T.p2[2]}</p>
    {WIKI_GROUPS.map((g, i) => (
      <>
        <h2 id={`g${i}`}>{gName(g)}</h2>
        <ul class="xxd-list" data-interactive>
          {items.filter((w) => w.group === g).map((w) => (
            <li class="xxd-list__item"><a class="xxd-list__main list-link" href={wikiHref(w.slug, lang)}><span class="xxd-list__title">{w.title}</span><span class="xxd-list__meta">{w.one.replace(/\*\*|==|\+\+/g, "")}</span></a></li>
          ))}
        </ul>
      </>
    ))}
  </article>
</Site>
