---
// 工具：按类型分组的卡片。锚点 toolId(name)。
import Site from "../layouts/Site.astro";
import Src from "../components/Src.astro";
import { TOOLS, TOOL_KINDS, toolId } from "../data/tools.js";
const headings = Object.keys(TOOL_KINDS).map((k, i) => ({ slug: `k${i}`, text: k, depth: 2 }));
---
<Site title="工具" description="能帮你看 AI 提没提你、爬虫来没来、页面合不合格的工具。" headings={headings}>
  <article class="xxd-prose">
    <h1>工具：监测、分析、体检</h1>
    <p>刚开始不用买工具，手动问几个 AI 就够了。问的次数多了、产品多了，再看下面这些。</p>
    {Object.entries(TOOL_KINDS).map(([k, sum], i) => {
      const items = TOOLS.filter((x) => x.kind === k);
      return (
        <>
          <h2 id={`k${i}`}>{k}</h2>
          <p>{sum}。</p>
          {items.length === 0 ? <p class="entry__meta">还没有条目。</p> : (
            <ul class="entries entries--grid">
              {items.map((x) => (
                <li class="entry" id={toolId(x.name)}>
                  <div class="entry__head"><h3 class="entry__title"><a href={x.url} rel="noopener">{x.name}</a></h3>{x.sample && <span class="sample-tag entry__meta">示例</span>}</div>
                  <p class="entry__meta">{x.price}</p>
                  <p>{x.measures}<Src ids={x.sources} /></p>
                  <p class="entry__meta">适合：{x.fit}</p>
                </li>
              ))}
            </ul>
          )}
        </>
      );
    })}
  </article>
</Site>
