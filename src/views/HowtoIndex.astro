---
import Site from "../layouts/Site.astro";
import { HOWTO, howtoHref, langOf, t } from "../data/nav.js";
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const headings = HOWTO.map((g, i) => ({ slug: `g${i}`, text: t(g, "group", lang), depth: 2 }));
const T = en
  ? { h: "How-to: how exactly", p: "One job per article: find your product type or the setting you're changing, and follow it.", pending: "In progress" }
  : { h: "How-to：具体怎么做", p: "一篇只讲一件事。先找你的产品类型，或者你要改的那项设置，照着做。", pending: "编写中" };
---
<Site title={T.h} headings={headings}>
  <article class="xxd-prose">
    <h1>{T.h}</h1>
    <p>{T.p}</p>
    {HOWTO.map((g, i) => (
      <>
        <h2 id={`g${i}`}>{t(g, "group", lang)}</h2>
        <ul class="xxd-list" data-interactive>
          {g.items.map((it) => it.ready
            ? <li class="xxd-list__item"><a class="xxd-list__main list-link" href={howtoHref(it.slug, lang)}><span class="xxd-list__title">{t(it, "title", lang)}</span></a></li>
            : <li class="xxd-list__item is-pending"><span class="xxd-list__main"><span class="xxd-list__title">{t(it, "title", lang)}</span></span><span class="xxd-badge">{T.pending}</span></li>)}
        </ul>
      </>
    ))}
  </article>
</Site>
